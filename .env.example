# ============================================
# UUID untuk autentikasi VLESS/Trojan/VMess
# Generate: uuidgen | tr 'A-Z' 'a-z'
# atau: https://www.uuidgenerator.net/
# ============================================
UUID=d1cf4b9c-3e57-085d-b34a-797fcf601381

# ============================================
# Port server (default 3000)
# Vercel akan override otomatis saat deploy
# ============================================
PORT=3000

# ============================================
# Debug log
# 1 = aktif, kosong/0 = mati
# ============================================
SHOW_LOG=

# ============================================
# Izinkan UUID apapun (untuk testing)
# true  = mode bebas (tidak aman untuk production)
# false = hanya UUID di atas yang diterima
# ============================================
ALLOW_ANY_UUID=false
